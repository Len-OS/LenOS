{
  "name": "lenos",
  "compatibility_date": "2026-08-04",
  "main": "src/index.ts",
  "routes": [
    { "pattern": "lenos-e2e32.lengrowth.com/*", "zone_name": "lengrowth.com" }
  ],
  "vars": {
    "RELAY_ORIGIN": "https://relay.lengrowth.com"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
